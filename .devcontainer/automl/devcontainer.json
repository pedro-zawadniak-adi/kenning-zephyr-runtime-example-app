{
    // container for running Kenning
    "name": "AutoML",
    "build": {
        "context": "../..",
        "dockerfile": "../../environments/Dockerfile"
    },
	"customizations": {
		"vscode": {
			"extensions": ["AnalogDevices.automl-embedded"]
		}
	},
	"runArgs": [
        "--device", "/dev/ttyUSB0",
        "--device", "/dev/ttyACM0",
        "--privileged"
    ]
}
